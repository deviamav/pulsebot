# ===== Bot (placeholders only — never commit real values) =====
# Get a token from @BotFather, then put it in local `.env` (not in git).
BOT_TOKEN=
# Optional bootstrap admins as Telegram numeric user IDs (placeholders):
# ADMIN_IDS=10001,10002
ADMIN_IDS=

# ===== App =====
APP_ENV=development
LOG_LEVEL=INFO
HEALTHCHECK_HOST=0.0.0.0
HEALTHCHECK_PORT=8080

# ===== PostgreSQL =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pulsebot
POSTGRES_USER=pulsebot
POSTGRES_PASSWORD=change_me_strong_password

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== Rate limiting =====
RATE_LIMIT_PER_SECOND=2

# ===== Reminders =====
REMINDER_CHECK_INTERVAL_SECONDS=300
